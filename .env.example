DATABASE_URL=postgresql://jobfinder:jobfinder@localhost:5432/jobfinder
NEXTAUTH_SECRET=change-me-generate-a-secret
NEXTAUTH_URL=http://localhost:3456
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GEMINI_API_KEY=
# System-wide Groq API key (used as default for all users without personal key)
JF_GROQ_API_KEY=
# Optional: SOCKS5 or HTTP proxy for scraping (e.g. socks5://user:pass@host:port)
SCRAPER_PROXY_URL=
# Secret for cron-triggered apply endpoint (generate with: openssl rand -hex 32)
JOBFINDER_CRON_SECRET=

# Email Routing (Cloudflare Email Workers)
# Shared token між CF Worker (jf-inbox) та JF API (generate: openssl rand -hex 32)
# Worker надсилає: Authorization: Bearer $JF_INBOX_TOKEN
# API endpoints: /api/admin/emails, /api/email-response, /api/user-email
JF_INBOX_TOKEN=

# Resend API key для відправки email (Reply/Forward з UI)
# https://resend.com → API Keys → Create (domain: taras.cloud)
RESEND_API_KEY=
