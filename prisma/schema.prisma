generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  image     String?
  googleId  String?  @unique @map("google_id")
  role      String   @default("user")
  preferredLocale String @default("en") @map("preferred_locale")
  preferredSkin   String @default("taras") @map("preferred_skin")
  preferredTheme  String @default("dark") @map("preferred_theme")
  createdAt DateTime @default(now()) @map("created_at")

  profile          UserProfile?
  searchProfiles   SearchProfile[]
  vacancyScores    VacancyScore[]
  applications     Application[]
  qaPairs          QaPair[]
  platformAccounts PlatformAccount[]
  aiFeedback       AiFeedback[]
  aiSettings       UserAISettings?
  notifications    Notification[]

  @@map("users")
}

model GuestInvite {
  email     String   @id
  invitedBy String   @map("invited_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("guest_invites")
}

model UserProfile {
  userId              Int      @id @map("user_id")
  headline            String?
  summary             String?
  yearsExperience     Int?     @map("years_experience")
  skills              String[]
  languages           String[]
  portfolioUrls       String[] @map("portfolio_urls")
  resumeUrl           String?  @map("resume_url")
  resumeText          String?  @map("resume_text")
  analysisStatus      String   @default("idle") @map("analysis_status")
  analysisResult      String?  @map("analysis_result")
  salaryMin           Int?     @map("salary_min")
  salaryCurrency      String?  @map("salary_currency")
  preferredLocations  String[] @map("preferred_locations")
  preferredRemoteType String?  @map("preferred_remote_type")
  employmentTypes     String[] @map("employment_types")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model SearchProfile {
  id                 Int      @id @default(autoincrement())
  userId             Int      @map("user_id")
  name               String
  isActive           Boolean  @default(true) @map("is_active")
  jobTitles          String[] @map("job_titles")
  minSalary          Int?     @map("min_salary")
  currency           String?
  employmentTypes    String[] @map("employment_types")
  remoteOnly         Boolean  @default(true) @map("remote_only")
  geographies        String[]
  excludedCompanies  String[] @map("excluded_companies")
  excludedIndustries String[] @map("excluded_industries")
  stackFilter        String[] @map("stack_filter")
  applyHoursStart    Int      @default(18) @map("apply_hours_start")
  applyHoursEnd      Int      @default(22) @map("apply_hours_end")
  applyTimezone      String   @default("Europe/Madrid") @map("apply_timezone")
  maxDailyApplies    Int      @default(20) @map("max_daily_applies")
  autoApply          Boolean  @default(false) @map("auto_apply")
  scrapeSchedule     String   @default("daily") @map("scrape_schedule")
  source             String   @default("manual")
  createdAt          DateTime @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancyScores VacancyScore[]
  applications  Application[]

  @@index([userId])
  @@map("search_profiles")
}

model Vacancy {
  id             Int       @id @default(autoincrement())
  platform       String
  externalId     String    @map("external_id")
  url            String
  title          String
  company        String?
  location       String?
  salaryText     String?   @map("salary_text")
  salaryMin      Int?      @map("salary_min")
  salaryMax      Int?      @map("salary_max")
  salaryCurrency String?   @map("salary_currency")
  salaryMinEur   Int?      @map("salary_min_eur")
  salaryMaxEur   Int?      @map("salary_max_eur")
  remoteType     String?   @map("remote_type")
  employmentType String?   @map("employment_type")
  description    String    @db.Text
  language       String?
  postedAt       DateTime? @map("posted_at")
  scrapedAt      DateTime  @default(now()) @map("scraped_at")
  rawHtml        String?   @db.Text @map("raw_html")
  isDuplicateOf  Int?      @map("is_duplicate_of")
  tagStack       String[]  @default([]) @map("tag_stack")
  tagLevel       String?   @map("tag_level")
  tagIndustry    String?   @map("tag_industry")
  tagTeamSize    String?   @map("tag_team_size")

  duplicateOf   Vacancy?  @relation("VacancyDuplicates", fields: [isDuplicateOf], references: [id], onDelete: SetNull)
  duplicates    Vacancy[] @relation("VacancyDuplicates")

  vacancyScores VacancyScore[]
  applications  Application[]
  qaPairs       QaPair[]

  @@unique([platform, externalId])
  @@map("vacancies")
}

model VacancyScore {
  id              Int      @id @default(autoincrement())
  vacancyId       Int      @map("vacancy_id")
  userId          Int      @map("user_id")
  searchProfileId Int      @map("search_profile_id")
  matchScore      Int      @map("match_score")
  salaryFit       Boolean? @map("salary_fit")
  remoteFit       Boolean? @map("remote_fit")
  notes           String?
  dismissed       Boolean  @default(false)
  scoredAt        DateTime @default(now()) @map("scored_at")
  scoredBy        String?  @map("scored_by")

  vacancy       Vacancy       @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchProfile SearchProfile @relation(fields: [searchProfileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vacancyId])
  @@map("vacancy_scores")
}

model Application {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  vacancyId       Int       @map("vacancy_id")
  searchProfileId Int       @map("search_profile_id")
  status          String    @default("queued")
  coverLetter     String?   @db.Text @map("cover_letter")
  interviewPrep   String?   @db.Text @map("interview_prep")
  appliedAt       DateTime? @map("applied_at")
  screenshotPath  String?   @map("screenshot_path")
  applyLog        String?   @db.Text @map("apply_log")
  createdAt       DateTime  @default(now()) @map("created_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancy       Vacancy       @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  searchProfile SearchProfile @relation(fields: [searchProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, vacancyId])
  @@index([userId])
  @@map("applications")
}

model QaPair {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  question        String
  answer          String?
  sourceVacancyId Int?      @map("source_vacancy_id")
  answeredAt      DateTime? @map("answered_at")
  timesUsed       Int       @default(0) @map("times_used")
  category        String?
  source          String    @default("manual") // "manual", "ai", "ai_edited"

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceVacancy Vacancy? @relation(fields: [sourceVacancyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("qa_pairs")
}

model PlatformAccount {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  platform          String
  authType          String    @default("password") @map("auth_type")
  email             String?
  passwordEncrypted String?   @map("password_encrypted")
  sessionData       String?   @db.Text @map("session_data")
  lastLogin         DateTime? @map("last_login")
  status            String    @default("active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("platform_accounts")
}

model AiFeedback {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  field     String   // "profile.headline", "profile.summary", "cover_letter", "qa.answer", etc.
  context   String?  @db.Text // the prompt/input that generated the content
  content   String   @db.Text // the AI-generated content
  rating    String   // "like" or "dislike"
  comment   String?  // optional user comment on why
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, field])
  @@map("ai_feedback")
}

model UserAISettings {
  userId        Int      @id @map("user_id")
  provider      String   @default("ollama") // ollama, gemini, groq
  ollamaUrl     String   @default("http://ollama:11434") @map("ollama_url")
  ollamaModel   String   @default("qwen2.5:14b-instruct-q4_K_M") @map("ollama_model")
  geminiApiKey  String?  @map("gemini_api_key")
  groqApiKey    String?  @map("groq_api_key")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_ai_settings")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String   // "new_vacancies", "application_response", "interview_scheduled", "qa_pending", "scrape_complete"
  title     String
  message   String
  link      String?  // URL to navigate to
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model CompanyResearch {
  id          Int      @id @default(autoincrement())
  companyName String   @unique @map("company_name")
  data        String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("company_research")
}

model EmailResponse {
  id            Int      @id @default(autoincrement())
  userId        Int?     @map("user_id")
  applicationId Int?     @map("application_id")
  fromEmail     String   @map("from_email")
  subject       String
  body          String?  @db.Text
  responseType  String   @map("response_type") // positive, rejection, interview, info
  matched       Boolean  @default(false)
  receivedAt    DateTime @default(now()) @map("received_at")

  @@map("email_responses")
}
